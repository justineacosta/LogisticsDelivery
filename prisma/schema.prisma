// Velocita Logistics — database schema
// PostgreSQL via Prisma. Run `pnpm db:push` for prototyping or `pnpm db:migrate` for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth Prisma adapter) ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  quoteRequests QuoteRequest[]
  shipments     Shipment[]
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Marketing & lead capture ──────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String   @db.Text
  source    String?  // page or campaign source
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model QuoteRequest {
  id              String          @id @default(cuid())
  userId          String?
  fullName        String
  email           String
  phone           String
  company         String?
  serviceType     ServiceType
  originCity      String
  originCountry   String
  destCity        String
  destCountry     String
  weightKg        Float
  volumeM3        Float?
  cargoType       String
  pickupDate      DateTime?
  notes           String?         @db.Text
  status          QuoteStatus     @default(NEW)
  estimatedPrice  Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum ServiceType {
  ROAD
  AIR
  OCEAN
  RAIL
  WAREHOUSING
  LAST_MILE
  CUSTOMS
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String?
  confirmed    Boolean  @default(false)
  confirmToken String?  @unique
  createdAt    DateTime @default(now())
}

// ─── Shipments & tracking ──────────────────────────────────────────────────────

model Shipment {
  id              String           @id @default(cuid())
  trackingNumber  String           @unique
  userId          String?
  serviceType     ServiceType
  status          ShipmentStatus   @default(BOOKED)
  originCity      String
  originCountry   String
  destCity        String
  destCountry     String
  weightKg        Float
  pieces          Int              @default(1)
  bookedAt        DateTime         @default(now())
  estimatedArrival DateTime?
  deliveredAt     DateTime?
  recipientName   String?
  carrier         String?
  events          ShipmentEvent[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackingNumber])
  @@index([status])
}

enum ShipmentStatus {
  BOOKED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String
  description String
  occurredAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ─── Content (CMS-ready) ───────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  coverImage  String?
  authorName  String
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model JobPosting {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String
  location    String
  type        String   // full-time, contract, etc.
  description String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
}
